# Django
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-random-value-of-at-least-50-characters
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,canteen.local
# Leave these off while testing authenticated pages over plain LAN HTTP.
# Set all four after the Cloudflare Tunnel hostname is configured.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_CLOUDFLARE_HEADERS=0
DJANGO_SECURE_COOKIES=0
DJANGO_SECURE_SSL_REDIRECT=0
# Enable HSTS only after the exact HTTPS hostname is working reliably.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0

# PostgreSQL
POSTGRES_DB=canteen
POSTGRES_USER=canteen
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgres://canteen:replace-with-the-url-encoded-database-password@db:5432/canteen
