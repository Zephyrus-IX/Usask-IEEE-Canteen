# Dockhand reads this committed .env file when deploying the stack.
# Keep placeholder values in Git. Replace them in Dockhand or on the deployment host
# before starting the production stack. Do not commit real secrets.

# Django
# Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Then paste the output below. It must be at least 50 characters and must not
# be left as any placeholder value when DJANGO_DEBUG=0.
DJANGO_SECRET_KEY=replace-with-a-random-value-of-at-least-50-characters
DJANGO_DEBUG=0

# Allowed hosts are the names users type into the browser.
# For LAN testing, include the mini PC hostname/IP as needed.
# At Cloudflare cutover, replace/add the exact public hostname.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,canteen.local

# Leave these off while testing authenticated pages over plain LAN HTTP.
# Set all four after the Cloudflare Tunnel hostname is configured and the base
# compose.yaml is only reachable through cloudflared.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_CLOUDFLARE_HEADERS=0
DJANGO_SECURE_COOKIES=0
DJANGO_SECURE_SSL_REDIRECT=0

# Enable HSTS only after the exact HTTPS hostname is working reliably.
# Do not enable subdomain coverage or preload until every affected hostname is
# confirmed HTTPS-only.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0

# PostgreSQL
POSTGRES_DB=canteen
POSTGRES_USER=canteen
# Generate a separate DB password with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If the generated password contains URL-special characters, URL-encode it in
# DATABASE_URL. The safest option is to paste the exact same generated value
# below and URL-encode only the DATABASE_URL copy if required.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgres://canteen:replace-with-a-long-random-database-password@db:5432/canteen
